# Copy to .env.local (git-ignored) and fill in for your machine.
# Config from env, not hardcoded (task brief) — see src/env.ts.

# Keycloak realm issuer. Local docker-compose: http://localhost:8080/auth/realms/gadonghr
# (matches deploy/docker-compose.yml's --http-relative-path=/auth). Staging: https://hr.bevorasg.com/auth/realms/gadonghr
VITE_OIDC_ISSUER=http://localhost:8080/auth/realms/gadonghr

# Must match deploy/keycloak/realm-gadonghr.json's public "web" client id.
VITE_OIDC_CLIENT_ID=web

# Must be registered in that client's redirectUris.
# NOTE: this hardcodes port 5173, Vite's default — but Vite does not
# enforce that port. If 5173 is already taken, `vite dev` silently moves to
# 5174 (or the next free port) and prints the port it actually bound to. This
# value does not follow that move, so the OIDC provider still redirects back
# to :5173 and the login lands nowhere. If sign-in redirects into a dead
# tab, check the terminal for the port Vite actually printed and either free
# up 5173 or update this value (and the client's registered redirectUris) to
# match.
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# Must match docker-compose.yml's OIDC_AUDIENCE (the oidc-audience-mapper's stamped aud claim).
VITE_OIDC_AUDIENCE=gadonghr-services

# Base URLs for the services this shell talks to today. No gateway/reverse
# proxy routes these yet (deploy/docker-compose.yml gives each service only
# an internal compose-network hostname) — for local dev, run each service
# with its HTTP port published to these values.
VITE_SVC_CONFIG_URL=http://localhost:3010
VITE_SVC_I18N_URL=http://localhost:3011

# The four screens built alongside the shell (`/compliance/audit`,
# `/documents`, `/admin/roles`, `/notifications`) — same "publish the
# service's own port locally" convention as the two above. In production
# these are same-origin relative paths through Traefik instead
# (`/api/audit`, `/api/docs`, `/api/authz`, `/api/notify` —
# deploy/README.md's routing table), baked in as `web/Dockerfile`'s ARG
# defaults rather than a `.github/workflows/ci.yml` build-arg, since that
# workflow's `web` matrix leg was not extended for this task.
VITE_SVC_AUDIT_URL=http://localhost:3012
VITE_SVC_DOCS_URL=http://localhost:3013
VITE_SVC_AUTHZ_URL=http://localhost:3014
VITE_SVC_NOTIFY_URL=http://localhost:3015

# Dev-only login bypass — see src/auth/devBypass.ts. Has zero effect in a
# `vite build` production bundle; only read when Vite's own `import.meta.env.DEV`
# is true (the dev server / vitest), which this flag cannot itself turn on.
VITE_DEV_BYPASS=false
