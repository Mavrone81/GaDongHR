# Copy to .env.local (git-ignored) and fill in for your machine.
# Config from env, not hardcoded (task brief) — see src/env.ts.

# Keycloak realm issuer. Local docker-compose: http://localhost:8080/auth/realms/gadonghr
# (matches deploy/docker-compose.yml's --http-relative-path=/auth). Staging: https://hr.bevorasg.com/auth/realms/gadonghr
VITE_OIDC_ISSUER=http://localhost:8080/auth/realms/gadonghr

# Must match deploy/keycloak/realm-gadonghr.json's public "web" client id.
VITE_OIDC_CLIENT_ID=web

# Must be registered in that client's redirectUris.
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# Must match docker-compose.yml's OIDC_AUDIENCE (the oidc-audience-mapper's stamped aud claim).
VITE_OIDC_AUDIENCE=gadonghr-services

# Base URLs for the two services this shell talks to today. No gateway/reverse
# proxy routes these yet (deploy/docker-compose.yml gives each service only
# an internal compose-network hostname) — for local dev, run each service
# with its HTTP port published to these values.
VITE_SVC_CONFIG_URL=http://localhost:3010
VITE_SVC_I18N_URL=http://localhost:3011

# Dev-only login bypass — see src/auth/devBypass.ts. Has zero effect in a
# `vite build` production bundle; only read when Vite's own `import.meta.env.DEV`
# is true (the dev server / vitest), which this flag cannot itself turn on.
VITE_DEV_BYPASS=false
