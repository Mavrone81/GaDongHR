{
  "realm": "gadonghr",
  "displayName": "GaDongHR",
  "enabled": true,
  "sslRequired": "external",

  "loginWithEmailAllowed": true,
  "registrationEmailAsUsername": false,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,

  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 43200,
  "ssoSessionIdleTimeoutRememberMe": 0,
  "ssoSessionMaxLifespanRememberMe": 0,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,

  "clients": [
    {
      "clientId": "web",
      "name": "GaDongHR PWA",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["https://hr.bevorasg.com/*"],
      "webOrigins": ["https://hr.bevorasg.com"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://hr.bevorasg.com/*",
        "oauth2.device.authorization.grant.enabled": "false",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "gadonghr-services-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "",
            "included.custom.audience": "gadonghr-services",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "seeder",
      "name": "GaDongHR bootstrap seeder service account",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "gadonghr-services-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "",
            "included.custom.audience": "gadonghr-services",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "id": "00000000-0000-4000-8000-00005eed0001",
      "username": "service-account-seeder",
      "enabled": true,
      "emailVerified": true,
      "serviceAccountClientId": "seeder"
    }
  ]
}
