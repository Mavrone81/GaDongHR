# Throwaway local credentials for the event-bus real-broker test stack
# ONLY (deploy/docker-compose.eventbus-test.yml). Copy to
# `.env.eventbus-test.local` (already gitignored by the root `.gitignore`'s
# `.env.*.local` pattern) and run:
#
#   docker compose -f docker-compose.yml -f docker-compose.eventbus-test.yml \
#     --env-file .env.eventbus-test.local up -d postgres rabbitmq
#
# These values are never used anywhere but a disposable local/CI container
# — do not reuse them for anything real.

POSTGRES_DB=gadonghr_eventbus_test
POSTGRES_SUPERUSER=gadonghr_test
POSTGRES_SUPERPASSWORD=gadonghr_test_pw

DB_PASSWORD_ONBOARDING=test_pw
DB_PASSWORD_SCHEDULER=test_pw
DB_PASSWORD_TIMESHEET=test_pw
DB_PASSWORD_ATTENDANCE=test_pw
DB_PASSWORD_LEAVE=test_pw
DB_PASSWORD_CLAIMS=test_pw
DB_PASSWORD_PAYROLL=test_pw
DB_PASSWORD_AUTHZ=test_pw
DB_PASSWORD_CONFIG=test_pw
DB_PASSWORD_AUDIT=test_pw
DB_PASSWORD_NOTIFY=test_pw
DB_PASSWORD_DOCS=test_pw
KC_DB_PASSWORD=test_pw

RABBITMQ_USER=gadong_test
RABBITMQ_PASSWORD=gadong_test_pw

EVENTBUS_TEST_POSTGRES_PORT=25432
EVENTBUS_TEST_RABBITMQ_PORT=25672
EVENTBUS_TEST_RABBITMQ_MGMT_PORT=25673

# docker-compose.yml also references these even though `postgres`/
# `rabbitmq` alone don't need them — `docker compose config`/`up` still
# parses the whole file, so unrelated `${VAR}` references must resolve to
# SOMETHING or Compose warns (harmless, but noisy). Empty is fine; these
# services are never started by the eventbus-test overlay.
PUBLIC_HOST=localhost
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=test_pw
VAULT_APPROLE_ID=unused
CONFIG_PACK_SIGNING_KEY=unused
SMTP_HOST=unused
SMTP_FROM=unused
SMTP_USER=unused
SMTP_PASS=unused
MINIO_ROOT_USER=unused
MINIO_ROOT_PASSWORD=unused
REDIS_PASSWORD=unused
GADONG_VERSION=main
