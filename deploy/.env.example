# GaDongHR environment template — copy to .env and fill in.
# NEVER commit .env (deploy/.gitignore already excludes it).
# Generate strong values:  openssl rand -base64 32
#
# Target host: gadonghr-prod, 157.230.38.96 (sgp1), 2 vCPU / 4 GB / 80 GB,
# dedicated — Traefik owns :80/:443 and terminates TLS itself. See
# deploy/README.md for the full memory budget this file's values are sized
# against.

# ---------- Deployment ----------
NODE_ENV=production
LOG_LEVEL=info
PUBLIC_HOST=hr.bevorasg.com            # public FQDN served by Traefik
# Task 16f: ACME_EMAIL is NOT read by Traefik itself anymore — Traefik's
# static config (traefik/traefik.yml) can't do the Go-templating that lets
# routes.yml read PUBLIC_HOST from the environment (verified: templating is
# dynamic-config only), so the ACME contact email is a plain committed
# value in traefik.yml, matching the default below. Kept here only as the
# canonical value to copy into that file if it ever needs to change.
ACME_EMAIL=admin@bevorasg.com          # Let's Encrypt notifications — see traefik/traefik.yml
DEFAULT_LOCALE=th                      # th | en | zh
# The ONE deploy-time image tag variable docker-compose.prod.yml reads,
# for all eight services (the seven platform services and `web`) — the
# exact commit sha CI built and pushed to GHCR as
# ghcr.io/mavrone81/gadonghr-<service>:<sha>. auto-deploy-gadonghr.sh sets
# this from refs/ci-pass/<sha> before `docker compose ... up -d` — real
# deploys never fall through to the value below. `stable` here is only a
# template placeholder: it's the mutable alias `.github/workflows/ci.yml`
# publishes ONLY for a push to the branch production actually tracks (its
# `env.GADONG_DEPLOY_BRANCH`), so it is safe to pull by hand but is never
# what a real deploy pins to. On the live server, `.env`'s `GADONG_VERSION`
# is kept pinned to the last CI-verified sha auto-deploy-gadonghr.sh
# actually deployed (auditable, immutable), not this floating alias.
#
# NOT to be confused with `GADONG_BUILD_SHA`: a DIFFERENT, build-time-only
# `docker build --build-arg` CI passes so a running container's
# /health.version can report which commit it was built from
# (packages/kernel/src/version.ts). GADONG_BUILD_SHA is never read at
# deploy time and deliberately does not appear in this file — using it as
# a deploy-time pull tag (instead of GADONG_VERSION) was Task 15's bug.
GADONG_VERSION=stable

# ---------- PostgreSQL (superuser bootstraps schema-per-service roles) ----------
POSTGRES_DB=gadonghr
POSTGRES_SUPERUSER=gadong_admin
POSTGRES_SUPERPASSWORD=CHANGE_ME
# Per-service role passwords — deploy/postgres/init/01-roles.sql reads
# each of these via `\getenv` and creates one LOGIN role per schema,
# scoped to that schema only (no cross-schema access). All twelve exist
# even though only config/authz/audit/notify/docs are wired into
# docker-compose.yml today — onboarding..payroll are forward-provisioned
# so a later phase needs no new Postgres bootstrap step.
DB_PASSWORD_ONBOARDING=CHANGE_ME
DB_PASSWORD_SCHEDULER=CHANGE_ME
DB_PASSWORD_TIMESHEET=CHANGE_ME
DB_PASSWORD_ATTENDANCE=CHANGE_ME
DB_PASSWORD_LEAVE=CHANGE_ME
DB_PASSWORD_CLAIMS=CHANGE_ME
DB_PASSWORD_PAYROLL=CHANGE_ME
DB_PASSWORD_AUTHZ=CHANGE_ME
DB_PASSWORD_CONFIG=CHANGE_ME
DB_PASSWORD_AUDIT=CHANGE_ME
DB_PASSWORD_NOTIFY=CHANGE_ME
DB_PASSWORD_DOCS=CHANGE_ME

# ---------- Keycloak (its own schema in the same Postgres database) ----------
KC_DB_PASSWORD=CHANGE_ME
KC_ADMIN_USER=kcadmin
KC_ADMIN_PASSWORD=CHANGE_ME
# Task 13c: every platform service validates bearer tokens against this
# Keycloak instance (packages/kernel/src/authz/oidc.middleware.ts).
# `OIDC_ISSUER`/`OIDC_AUDIENCE`/`OIDC_JWKS_URI` are set directly in
# docker-compose.yml's `x-oidc-env` anchor (not here) because they are not
# secrets — `OIDC_ISSUER` is derived from `PUBLIC_HOST` above plus the
# fixed realm name.
#
# Task 15b: the `gadonghr` realm itself (clients `web`, `seeder`) IS now
# provisioned — see deploy/keycloak/realm-gadonghr.json, imported
# automatically by the `keycloak` service's `--import-realm` flag. What
# remains manual, like the Vault unseal ceremony (vault-init.sh):
# `deploy/scripts/seed.sh` (pins the `seeder` client secret below and
# grants it its svc-authz permissions) and
# `deploy/scripts/bootstrap-admin.sh` (creates the first HR/System Admin
# below) — see deploy/keycloak/README.md and Runbook §1's install order.
#
# The `seeder` client's confidential secret — realm-import JSON cannot
# safely carry a real secret (see deploy/keycloak/README.md), so
# `deploy/scripts/seed.sh` pins the realm's auto-generated placeholder to
# this value via the Keycloak Admin REST API on every run.
KEYCLOAK_SEEDER_CLIENT_SECRET=CHANGE_ME
# S2S auth task: the four machine-identity clients' confidential secrets —
# same pin-via-Admin-REST mechanism as KEYCLOAK_SEEDER_CLIENT_SECRET above,
# also done by `deploy/scripts/seed.sh` on every run. Forward-provisioned
# like DB_PASSWORD_ONBOARDING/etc. above: svc-onboarding, svc-payroll,
# svc-timesheet and svc-scheduler are not in docker-compose.yml's seven-
# platform-service set yet, but their realm clients and svc-authz grants
# are ready for the phase that adds them (deploy/keycloak/realm-gadonghr.json,
# deploy/scripts/seed.sh). Each becomes an outbound `S2S_CLIENT_SECRET` env
# var for that service's own container once it is added to compose.
KEYCLOAK_SVC_ONBOARDING_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_SVC_PAYROLL_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_SVC_TIMESHEET_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_SVC_SCHEDULER_CLIENT_SECRET=CHANGE_ME
# crypto-auth task: four more machine-identity clients' confidential
# secrets, same pin-via-Admin-REST mechanism, done by `deploy/scripts/
# seed.sh` on every run — svc-crypto's callers. svc-docs is already a live
# compose service (below); svc-attendance/svc-claims/svc-leave are
# forward-provisioned like the four above, ready for the phase that adds
# their compose service blocks.
KEYCLOAK_SVC_ATTENDANCE_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_SVC_CLAIMS_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_SVC_LEAVE_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_SVC_DOCS_CLIENT_SECRET=CHANGE_ME
# The first HR/System Admin's Keycloak login (deploy/scripts/bootstrap-admin.sh).
# BOOTSTRAP_ADMIN_TEMP_PASSWORD is a ONE-TIME password — Keycloak forces a
# change (plus OTP enrolment) at first login; it is never reused after that.
BOOTSTRAP_ADMIN_EMAIL=admin@bevorasg.com
BOOTSTRAP_ADMIN_TEMP_PASSWORD=CHANGE_ME

# ---------- Vault / crypto ----------
# AppRole for svc-crypto (created by the vault-init.sh ceremony, Runbook
# §2; the secret half goes to ./secrets/vault_approle_secret, gitignored,
# never in this file).
VAULT_APPROLE_ID=CHANGE_ME
# NOTE: Vault unseal keys are NOT env vars, ever. The init ceremony
# outputs 5 Shamir shares, threshold 3 — distribute to key officers per
# the runbook. Loss of 3+ shares is PERMANENT, IRREVERSIBLE loss of every
# encrypted field in the system. See deploy/vault/vault.hcl's header.

# ---------- svc-config ----------
# Signs/verifies imported statutory rule packs (packs.service.ts). Not the
# same value as any DB password — a distinct HMAC key.
CONFIG_PACK_SIGNING_KEY=CHANGE_ME

# ---------- Broker / cache / storage ----------
# RabbitMQ and Redis are provisioned per this task's brief (required
# infra) but nothing in Phase 1's seven services publishes or consumes
# from either yet — the outbox relay's live broker adapter and any
# session/cache use are later work. See deploy/README.md.
RABBITMQ_USER=gadong
RABBITMQ_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=gadong-minio
MINIO_ROOT_PASSWORD=CHANGE_ME
DOCS_BUCKET=gadonghr-docs

# ---------- svc-notify (SMTP) ----------
SMTP_HOST=smtp.example.co.th
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=no-reply@bevorasg.com
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME

# ---------- Backups (scripts/backup.sh) ----------
# age public key backups are encrypted to; the matching private key is the
# OFFLINE backup key (Runbook §3) — never on this host, never in this
# file.
BACKUP_AGE_RECIPIENT=CHANGE_ME

# ---------- Ops alerting (ops-hardening: scripts/gadonghr-alert.sh, scripts/gadonghr-monitor.sh) ----------
# The ONE env var that is the alert channel — not a secret, but keep it
# out of git anyway (an ntfy.sh topic name or webhook path is a
# possession-based credential in practice). Leave unset and every alert
# still lands in the local log (GADONG_ALERT_LOG below) — no channel
# configured is not a failure, just an onboarding step not yet done.
#   ntfy.sh:       https://ntfy.sh/<a-hard-to-guess-topic-name>
#   Slack webhook: https://hooks.slack.com/services/... (also set
#                  GADONG_ALERT_WEBHOOK_JSON=true below — Slack needs a
#                  JSON {"text": "..."} body, not a raw POST body)
#   Generic:       any endpoint that accepts a POST with the alert text
#                  as the body (or as JSON if GADONG_ALERT_WEBHOOK_JSON=true)
GADONG_ALERT_WEBHOOK_URL=
GADONG_ALERT_WEBHOOK_JSON=false
# Overridable, but the defaults below match deploy/scripts/install-ops-hardening.sh
# and deploy/systemd/*.service — only change these together.
# GADONG_ALERT_LOG=/var/log/gadonghr-alerts.log
# GADONG_MONITOR_MAX_DISK_PCT=85
# GADONG_MONITOR_MAX_BACKUP_AGE_HOURS=30
# GADONG_MONITOR_REALERT_MINUTES=60
