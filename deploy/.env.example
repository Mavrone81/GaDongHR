# GaDongHR environment template — copy to .env and fill in.
# NEVER commit .env. Production should migrate high-value secrets to Docker secrets.
# Generate strong values:  openssl rand -base64 32

# ---------- Deployment ----------
GADONG_VERSION=latest
NODE_ENV=production
LOG_LEVEL=info
PUBLIC_HOST=hr.example.co.th          # public FQDN served by Traefik
ACME_EMAIL=admin@example.co.th        # Let's Encrypt notifications
DEFAULT_LOCALE=th                     # th | en | zh

# ---------- PostgreSQL (superuser bootstraps schema-per-service roles) ----------
POSTGRES_DB=gadonghr
POSTGRES_SUPERUSER=gadong_admin
POSTGRES_SUPERPASSWORD=CHANGE_ME
# Per-service role passwords (init scripts create roles limited to their schema)
DB_PASSWORD_ONBOARDING=CHANGE_ME
DB_PASSWORD_SCHEDULER=CHANGE_ME
DB_PASSWORD_TIMESHEET=CHANGE_ME
DB_PASSWORD_ATTENDANCE=CHANGE_ME
DB_PASSWORD_LEAVE=CHANGE_ME
DB_PASSWORD_CLAIMS=CHANGE_ME
DB_PASSWORD_PAYROLL=CHANGE_ME
DB_PASSWORD_AUTHZ=CHANGE_ME
DB_PASSWORD_CONFIG=CHANGE_ME
DB_PASSWORD_AUDIT=CHANGE_ME
DB_PASSWORD_NOTIFY=CHANGE_ME
DB_PASSWORD_DOCS=CHANGE_ME

# ---------- Keycloak ----------
KC_DB_PASSWORD=CHANGE_ME
KC_ADMIN_USER=kcadmin
KC_ADMIN_PASSWORD=CHANGE_ME

# ---------- Vault / crypto ----------
# AppRole for svc-crypto (created during `make vault-init`; secret goes to ./secrets/vault_approle_secret)
VAULT_APPROLE_ID=CHANGE_ME
# NOTE: Vault unseal keys are NOT env vars. The init ceremony outputs Shamir shares —
# distribute to key officers per the runbook. Loss of quorum = permanent data loss.

# ---------- Broker / cache / storage ----------
RABBITMQ_USER=gadong
RABBITMQ_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=gadong-minio
MINIO_ROOT_PASSWORD=CHANGE_ME

# ---------- CompreFace ----------
CF_DB_USER=frs
CF_DB_PASSWORD=CHANGE_ME
FACE_MATCH_THRESHOLD=0.92             # tune after ADR-007 benchmark (PRD Q2)

# ---------- Notifications ----------
SMTP_URL=smtp://user:pass@smtp.example.co.th:587

# ---------- Observability profile ----------
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
