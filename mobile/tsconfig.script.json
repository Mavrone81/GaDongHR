{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "src/api/**/*.ts", "../test/e2e/harness.ts", "../test/e2e/lib/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/node_modules/**"]
}
