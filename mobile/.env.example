# Copy to .env.local (git-ignored) and fill in for your machine, OR export
# these as real shell env vars before `expo start` — Expo inlines any
# `process.env.EXPO_PUBLIC_*` reference at bundle time (see src/api/env.ts).

# Keycloak realm issuer (production) or the e2e stand-in oidc-issuer's URL
# (local dev against test/e2e's stack: http://127.0.0.1:18081).
EXPO_PUBLIC_OIDC_ISSUER=http://127.0.0.1:18081

# Must be registered in the OIDC client's redirectUris. The value this app
# actually presents is computed at runtime by expo-auth-session's
# makeRedirectUri() (see src/auth/AuthContext.tsx) — check the Expo dev
# server log / Expo Go for the exact value on your machine and register that.
EXPO_PUBLIC_OIDC_CLIENT_ID=mobile
EXPO_PUBLIC_OIDC_AUDIENCE=gadonghr-services

# Same-origin default for production turn-on (task brief: "config, not
# code"). Leave unset for production once a gateway routes /api/<svc>.
EXPO_PUBLIC_API_BASE_URL=/api

# Local dev against test/e2e's stack: no shared gateway, every service is
# its own http://127.0.0.1:<port> (see test/e2e/harness.ts's PORTS).
EXPO_PUBLIC_SVC_ATTENDANCE_URL=http://127.0.0.1:18006
EXPO_PUBLIC_SVC_TIMESHEET_URL=http://127.0.0.1:18007
EXPO_PUBLIC_SVC_PAYROLL_URL=http://127.0.0.1:18008
EXPO_PUBLIC_SVC_DOCS_URL=http://127.0.0.1:18009
EXPO_PUBLIC_SVC_CONFIG_URL=http://127.0.0.1:18002
# svc-leave and svc-i18n are NOT part of test/e2e's compose stack (task
# brief, API reality) — there is no local port to point these at today.
# EXPO_PUBLIC_SVC_LEAVE_URL=
# EXPO_PUBLIC_SVC_I18N_URL=
